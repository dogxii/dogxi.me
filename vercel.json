{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"regions": ["hkg1"],
	"headers": [
		{
			"source": "/",
			"headers": [
				{ "key": "Cache-Control", "value": "public, s-maxage=600, max-age=60" }
			]
		},
		{
			"source": "/index.html",
			"headers": [
				{ "key": "Cache-Control", "value": "public, s-maxage=600, max-age=60" }
			]
		},
		{
			"source": "/(.*)\\.html",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, s-maxage=1800, max-age=300"
				}
			]
		},
		{
			"source": "/favicon\\.ico",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, immutable, s-maxage=2592000, max-age=2592000"
				}
			]
		}
	]
}
